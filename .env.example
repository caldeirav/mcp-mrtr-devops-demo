# LM Studio Local LLM Settings
# Keep MODEL_NAME / OPENAI_API_* aligned with agentgateway.yaml llm.params
OPENAI_API_BASE=http://127.0.0.1:1234/v1
OPENAI_API_KEY=lm-studio
MODEL_NAME=qwen/qwen3.6-35b-a3b

# Gateway and Server Configuration
AGENTGATEWAY_PORT=8080
MCP_SERVER_PORT=8000
# Use a long random hex/secret; never commit real values in .env
MCP_HMAC_SECRET=replace-with-a-long-random-secret

# Optional observability (Jaeger all-in-one via Podman or Docker)
# 0 = do not start Jaeger (default; HITL demo still works)
# 1 = start or reuse container "jaeger" (ports 16686 UI, 4317 OTLP gRPC)
ENABLE_JAEGER=0
# Container CLI: podman | docker | absolute path. Default: prefer podman, else docker.
# CONTAINER_RUNTIME=podman

# Demo ports (reference — not all are env vars):
#   1234  LM Studio OpenAI API
#   8000  MCP server
#   8080  agentgateway MCP proxy
#   15000 agentgateway admin UI (LLM playground)
#   4317  OTLP gRPC (Jaeger)
#   16686 Jaeger UI
